"""Optional native Python fixture for the store declared in the adjacent case.yml."""
import argparse
from contextlib import contextmanager
from pathlib import Path

from setrya.erasure import run_shared
from setrya.erasure.casefile import load_case
from setrya.erasure.modes import CLI_MODES, evidence_mode
from setrya.receipts import exit_code, report

PROFILE = load_case(Path(__file__).with_name("case.yml"))
CASE = PROFILE.case


@contextmanager
def open_fixture(*, on_unavailable=None):
    with PROFILE.open_stores(on_unavailable=on_unavailable) as (subject, application, items):
        # Bind your application's methods here:
        # application.read = read_as_test_user
        # application.erase = erase_fixture_subject
        # inspect, scan and app.journal are connected to the configured store.
        yield subject, application, items


def run(output, mode="deletion"):
    with open_fixture() as (subject, app, items):
        return run_shared(subject, case=CASE, application=app, external_items=items, journal=app.journal,
                          mode=mode, output=output)


def test_erasure(tmp_path):
    receipt = run(tmp_path / "receipt")
    assert exit_code(receipt) == 0, receipt["technical_verdict"]


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", type=evidence_mode, choices=CLI_MODES, default="deletion")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    receipt = run(args.output, args.mode)
    raise SystemExit(report(receipt, bundle=args.output))
